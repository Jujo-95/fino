# Loaded by the provider at each request. Never commit .env.
FINOPS_LLM_PROVIDER=nvidia
FINOPS_LLM_MODEL=z-ai/glm-5.3-flash
NVIDIA_API_KEY=
# Agent tool calls need more output tokens than the 1024-token connectivity example.
FINOPS_MAX_TOKENS=4096
FINOPS_REASONING_EFFORT=low
# Explicit offline demonstration only: FINOPS_LLM_PROVIDER=mock

# Shared NVIDIA request budget (single backend process)
FINOPS_LLM_RPM=30
FINOPS_LLM_CONCURRENCY=2
FINOPS_LLM_ATTEMPTS=2
FINOPS_LLM_READ_TIMEOUT=30
FINOPS_LLM_QUEUE_TIMEOUT=30
FINOPS_LLM_MAX_PENDING=8
# Optional explicit backup; only transient pre-response failures use it
FINOPS_LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Gemini via Vertex AI: switch FINOPS_LLM_PROVIDER to gemini.
# This project is billed; an API key does not provide an automatic spending cap.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash

# Groq (not xAI Grok): select in Connection IA or FINOPS_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4096
